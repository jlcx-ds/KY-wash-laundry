// Example Firestore rules — for a real deployment, tighten these further
// (e.g. verify passwords via Firebase Auth custom tokens/Cloud Functions
// instead of storing them in plain documents). This starter keeps things
// simple so the app works out of the box for a class project.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /machines/{machineId} {
      allow read, write: if true;
    }
    match /waitlist/{entryId} {
      allow read, write: if true;
    }
    match /history/{entryId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /feedback/{entryId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /issues/{entryId} {
      allow read, write: if true;
    }
    match /chat/{entryId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}
